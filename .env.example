# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
SECRET_KEY=change-this-in-production-to-a-secure-random-string
DEMO_MODE=true

# Database
DATABASE_URL=sqlite:///./data/traces.db

# LLM Advisory Provider (Optional, offline deterministic core operates without key)
# LLM_API_KEY is the only secret credential variable.
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen3.8-27b
LLM_BASE_URL=https://llm.chris-vo.com/v1

# OIDC / Keycloak Authentication
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/agent-observatory
OIDC_CLIENT_ID=agent-trace-observatory
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
OIDC_AUDIENCE=agent-trace-observatory

# CORS / Frontend
FRONTEND_ORIGIN=http://127.0.0.1:5173
